# Внутреннее (LAN-only) развёртывание, без внешнего домена — публичный
# ACME/Lets Encrypt тут неприменим (нет DNS-имени, доступного из
# интернета для HTTP-01/TLS-ALPN-01 challenge). "tls internal"
# использует встроенный локальный CA Caddy: самоподписанный
# сертификат, браузер один раз покажет предупреждение - это ожидаемо
# для внутренней сети, не ошибка конфигурации.
:8443 {
	tls internal

	reverse_proxy gridforge:8100
}
