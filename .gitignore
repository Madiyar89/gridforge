data/
*.pyc
__pycache__/

# Опциональный corporate/state root CA (certs/README.md) — конкретный
# сертификат конкретной сети никогда не должен попасть в публичный репо.
certs/*.crt
certs/*.pem

# Резервные копии файлов и кеш pytest — не должны попадать в репозиторий.
*.bak*
.pytest_cache/

# Локальные offline-костыли для сборки под TLS-инспекцией (не коммитить)
